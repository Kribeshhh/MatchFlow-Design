{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../dist/api",
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../prisma/seed.ts",
    "../../tests/**/*.ts",
    "../../scripts/*.ts"
  ]
}
