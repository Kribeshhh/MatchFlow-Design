{
  "name": "matchflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "build": "node scripts/clean-build.mjs && prisma generate && npm run typecheck && tsc -p apps/api/tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:web": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "start": "NODE_ENV=production node dist/api/apps/api/src/index.js",
    "db:local": "node scripts/local-db.mjs",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "npm run test:unit && npm run test:integration",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "test:integration": "node scripts/test.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "db:validate": "prisma validate",
    "db:status": "prisma migrate status",
    "test:e2e": "node scripts/e2e.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "db:preflight": "node scripts/migration-preflight.mjs",
    "auth:cleanup": "tsx scripts/auth-maintenance.ts",
    "admin:grant": "tsx scripts/grant-platform-admin.ts",
    "media:cleanup": "tsx scripts/media-maintenance.ts",
    "notifications:worker": "tsx scripts/notification-worker.ts",
    "notifications:jobs": "tsx scripts/notification-jobs.ts",
    "privacy:cleanup": "tsx scripts/privacy-maintenance.ts",
    "test:restore": "node scripts/test-restore.mjs",
    "test:release": "node scripts/test-release.mjs",
    "security:static": "semgrep scan --config infra/security/semgrep.yml --error --metrics=off --disable-version-check apps packages",
    "start:worker": "NODE_ENV=production node dist/api/scripts/notification-worker.js",
    "release:config": "node dist/api/scripts/release-config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@prisma/client": "^6.19.3",
    "argon2": "0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.8",
    "otpauth": "9.6.0",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "9.2.5",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "jose": "6.2.14",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "11.0.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
