DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/matchflow
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/matchflow_test
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
# NODE_ENV=production requires HTTPS for secure session cookies.

# Runtime binding/logging (production CLIENT_ORIGIN must be HTTPS)
HOST=127.0.0.1
LOG_LEVEL=info
# Optional local-only seed: supply DEMO_SEED_PASSWORD securely; never commit it.
# SEED_DEMO_DATA=yes
# Vite development/test proxy override; not a browser credential.
# API_PROXY_TARGET=http://127.0.0.1:3001

# Canonical public origin used in email links and OAuth callbacks.
APP_ORIGIN=http://localhost:5173
# SMTP: configure HOST and MAIL_FROM together; USER and PASSWORD together if needed.
# SMTP_HOST=your-provider-host
SMTP_PORT=587
SMTP_SECURE=false
# MAIL_FROM=accounts@your-domain.example
# SMTP_USER=your-provider-user
# SMTP_PASSWORD=configure-outside-source-control
# GOOGLE_CLIENT_ID=configure-in-local-env-or-secret-manager
# GOOGLE_CLIENT_SECRET=configure-in-local-env-or-secret-manager

# Optional S3-compatible uploads. Leave unconfigured until a provider is chosen.
# Keep bucket private; browser access goes through authorized /api/media/:id.
# Configure all four values together in a secret manager/local .env:
# S3_REGION=your-region
# S3_BUCKET=your-private-bucket
# S3_ACCESS_KEY_ID=configure-outside-source-control
# S3_SECRET_ACCESS_KEY=configure-outside-source-control
# S3_ENDPOINT=https://your-s3-compatible-endpoint.example
# S3_FORCE_PATH_STYLE=false

# Run the durable notification worker in API processes, or disable and run notifications:worker.
NOTIFICATION_WORKER=true

# Optional signed webhooks: same 32-byte lowercase hex key on API and worker instances.
# Generate with a secret manager or: openssl rand -hex 32
# WEBHOOK_ENCRYPTION_KEY=configure-outside-source-control

# Optional Cloudflare for SaaS: configure all four together on API and worker.
# CLOUDFLARE_ZONE_ID=your-32-character-zone-id
# CLOUDFLARE_API_TOKEN=configure-in-secret-manager
# PORTAL_CNAME_TARGET=customers.your-platform-domain.example
# PORTAL_ORIGIN_SECRET=generate-32-random-bytes-as-64-lowercase-hex-characters
# Optional explicit provider-approved public apex addresses, comma separated.
# PORTAL_APEX_ADDRESSES=
# Platform policy, not an organization-controlled entitlement.
PORTAL_ALLOW_HIDE_ATTRIBUTION=false

# Mandatory for platform staff access. Generate independently of webhook/domain keys.
# STAFF_MFA_KEY=generate-32-random-bytes-as-64-lowercase-hex-characters
SUPPORT_RETENTION_DAYS=90
MODERATION_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
# Public support/appeals mailbox, required before public launch.
# SUPPORT_CONTACT_EMAIL=support@your-platform-domain.example

# Exact trusted ingress IPs/CIDRs only; empty means no forwarded-header trust.
TRUSTED_PROXIES=
