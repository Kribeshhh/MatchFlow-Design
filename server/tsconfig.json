{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../server-dist",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../prisma/seed.ts", "../tests/**/*.ts"]
}
